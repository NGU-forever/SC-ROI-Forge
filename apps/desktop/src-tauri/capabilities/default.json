{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities for SC ROI Forge",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/sc-roi-api",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-spawn"
  ]
}
