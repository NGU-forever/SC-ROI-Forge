{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC ROI Forge",
  "version": "0.1.0",
  "identifier": "com.scroi.forge",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web -- --port 1420 --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "VITE_API_URL=http://127.0.0.1:8000 npm run build --prefix ../web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SC ROI Forge",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/sc-roi-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
